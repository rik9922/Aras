    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:run": "npm run ios:sync && bash scripts/ios-run.sh",
    "ios:open": "npx cap open ios",
    "assets:generate": "rm -f assets/splash-dark.png && cp src/assets/icon.png assets/icon.png && npx @capacitor/assets generate --ios --iconBackgroundColor '#ffffff' --splashBackgroundColor '#d4aa2a' && node scripts/ios-splash-single-mode.js",
    "start:local": "ng serve --configuration local --host localhost --port 8100",
    "build:local": "ng build --configuration local"
  },
